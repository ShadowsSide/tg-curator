# ===== 必填 =====
# @BotFather 给的 token
BOT_TOKEN=123456:ABC-DEF
# 发布频道：@channel_username 或 -100xxxxxxxxxx（机器人需是频道管理员，有发消息权限）
CHANNEL_ID=@your_channel
# 审核群 ID（-100 开头，机器人需在群内）
REVIEW_CHAT_ID=-1001234567890

# ===== 可选 =====
# 时区（定时发布、统计“今天”的边界都按它算）
TZ=Asia/Shanghai
# 署名模板，{name} 会替换为投稿人链接
SIGN_TEMPLATE=投稿人：{name}
# 匿名投稿在频道里的落款，留空则不加落款
ANON_SIGNATURE=匿名投稿
# 每人同时最多几条“未处理”投稿（草稿 + 待审核）
MAX_PENDING_PER_USER=5
# 相册收集等待秒数（相册的每张图是分开到达的）
ALBUM_DELAY=1.5
# 定时发布面板里的快捷时间点（取下一次出现的该时刻）
SCHEDULE_PRESETS=09:00,12:00,18:00,21:00
# 新投稿默认是否静音发送到频道（订阅者收到无声通知），审核时可逐条切换
DEFAULT_SILENT=false

# 审核统计提醒间隔（分钟），0 表示关闭；按整点对齐
REMINDER_INTERVAL_MINUTES=60
# 仅在有待审核投稿时提醒
REMINDER_ONLY_WHEN_PENDING=true
# 免打扰时段（小时，含头不含尾），例如 0-8；留空不启用
REMINDER_QUIET_HOURS=0-8
# 统计口径：today = 接受/拒绝只算今天审核的；all = 全部历史
STATS_SCOPE=today

# 访问 Telegram 需要代理时填写，支持 http:// 和 socks5://，例如 socks5://127.0.0.1:7890
# 注意：在 Docker 里运行时，127.0.0.1 指的是容器自己，宿主机上的代理请用 host.docker.internal 或宿主机 IP
PROXY=
# 自建 Bot API 服务器地址（可选，用于突破 20MB/50MB 文件限制），例如 http://telegram-bot-api:8081
TELEGRAM_API_URL=

# 可选：使用预构建的多架构镜像（见 README「多架构」）
# IMAGE=ghcr.io/your-name/tg-submit-bot:latest
# IMAGE=your-dockerhub-name/tg-submit-bot:latest   # 或者用 Docker Hub 上的镜像
