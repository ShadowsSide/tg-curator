# English example. 中文版：.env.example
# Grouped like "Configuration" in the README: Required / Common / Advanced

# ===== Required =====
# Token from @BotFather
BOT_TOKEN=123456:ABC-DEF
# Channel to publish to: @channel_username or -100xxxxxxxxxx (the bot must be a channel admin allowed to post)
CHANNEL_ID=@your_channel
# Review group ID (starts with -100; the bot must be a member)
REVIEW_CHAT_ID=-1001234567890

# ===== Common =====
# Language: zh | en — used in the review group, channel signatures and the review summary
LANGUAGE=en
# Language submitters see: auto = follow their Telegram app (Chinese for Chinese clients, English otherwise); or fix it to zh / en
USER_LANGUAGE=auto
# Who can review (buttons and commands in the review group): admins = review group admins and owner; all = every member;
# or user IDs, combinable, e.g. admins,123456 means the admins plus this person
REVIEWERS=admins
# Time zone (used for scheduling and for where "today" starts in stats)
TZ=Asia/Shanghai
# Signature for signed posts; {name} becomes a link to the submitter. Unset: default for LANGUAGE (Submitted by {name} / 投稿人：{name})
# SIGN_TEMPLATE=Submitted by {name}
# Signature for anonymous posts. Unset: default for LANGUAGE; set it to empty (ANON_SIGNATURE=) for none
# ANON_SIGNATURE=Anonymous submission
# Reasons offered after tapping Reject, separated by |. Unset: defaults for LANGUAGE; set it to empty (REJECT_TEMPLATES=) to skip the reason panel
# REJECT_TEMPLATES=Duplicate|Off-topic|Low quality|Advertising
# Maximum open submissions per user at a time (drafts + pending review)
MAX_PENDING_PER_USER=5
# Quick time buttons in the schedule panel (each means the next time that clock time comes round)
SCHEDULE_PRESETS=09:00,12:00,18:00,21:00
# Publish new submissions silently by default (subscribers get no sound); can be toggled per submission during review
DEFAULT_SILENT=false
# Review summary interval in minutes, 0 turns it off; aligned to the clock
REMINDER_INTERVAL_MINUTES=60
# Quiet hours (start included, end excluded), e.g. 0-8; leave empty to disable
REMINDER_QUIET_HOURS=0-8
# Proxy for reaching Telegram, http:// and socks5:// supported, e.g. socks5://127.0.0.1:7890
# Note: inside Docker, 127.0.0.1 is the container itself; for a proxy on the host use host.docker.internal or the host's IP
PROXY=
# Use a prebuilt multi-arch image (see "Deploy" in the README)
# IMAGE=ghcr.io/your-name/tg-submit-bot:latest
# IMAGE=your-dockerhub-name/tg-submit-bot:latest   # or an image on Docker Hub

# ===== Advanced (the defaults are usually fine) =====
# Spam checks, all off by default
# Keyword blacklist, comma-separated, case-insensitive (Chinese matches as a substring); checks both the text and link addresses
SPAM_KEYWORDS=
# Maximum links per submission, 0 = no limit; domains in LINK_WHITELIST (subdomains included) don't count
MAX_LINKS=0
LINK_WHITELIST=
# On a keyword or link-limit hit: flag = submit as usual and mark the control message ⚠️ possible spam; block = refuse it (without telling the submitter which word matched), they can edit and resubmit
SPAM_ACTION=flag
# Submitters with nothing published yet must wait this many minutes between submissions; 0 = no limit
NEW_USER_COOLDOWN_MINUTES=0
# /msg between reviewers and submitters: days after publishing or rejecting during which messaging stays open; always open during review
MSG_WINDOW_DAYS=3
# The bot only responds in private chats and the review group. It leaves any other group or channel it's added to; false = stay but never respond
# The publishing channel and its linked discussion group are whitelisted and never left (the linked group is detected at startup)
LEAVE_UNKNOWN_CHATS=true
# Seconds to wait while collecting an album (each item of an album arrives separately)
ALBUM_DELAY=1.5
# Only post the summary when something is waiting for review
REMINDER_ONLY_WHEN_PENDING=true
# Stats scope: today = accepted/rejected counts cover today's reviews only; all = all time
STATS_SCOPE=today
# Self-hosted Bot API server (lifts the 20 MB / 50 MB file limits), e.g. http://telegram-bot-api:8081
TELEGRAM_API_URL=
